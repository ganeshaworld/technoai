# ==============================================================================
# TECHNOPIE AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in backend and frontend as needed, or populate with
# your production secret keys.
# Never commit actual secret keys or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
DEBUG=True
APP_NAME="Technopie AI"
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_jwt_and_cryptography
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector / Supabase)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./technopie.db
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/technopie_ai

# Supabase Managed Database & Auth (Optional / Alternative)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. AI PROVIDER API KEYS (Configurable Multi-Provider Abstraction Layer)
# ------------------------------------------------------------------------------
# Primary default provider: openai | gemini | anthropic | mock
DEFAULT_AI_PROVIDER=gemini
DEFAULT_FAST_MODEL=gemini-2.5-flash
DEFAULT_REASONING_MODEL=gemini-2.5-pro
ALLOW_MOCK_FALLBACK=false
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=3

# Google Gemini API
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. GOOGLE WORKSPACE OAUTH (Gmail & Google Calendar Integrations)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Token Encryption Key (AES-256-GCM 32-byte Base64 key for encrypting OAuth tokens)
TOKEN_ENCRYPTION_KEY=your_32_byte_base64_encoded_encryption_key_here

# ------------------------------------------------------------------------------
# 5. VOICE SERVICES (Speech-to-Text & Text-to-Speech)
# ------------------------------------------------------------------------------
# Options: browser_native | openai_whisper | elevenlabs
STT_PROVIDER=browser_native
TTS_PROVIDER=browser_native
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (Subscriptions & Billing)
# ------------------------------------------------------------------------------
# Razorpay (India & Global)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (Global)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# 7. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Technopie AI"
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

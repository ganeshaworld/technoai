# ==============================================================================
# TECHNOPIE AI — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your root/backend directories for local development,
# or input these variables into Render / Supabase dashboards for production.
# Never commit actual secret keys, database files, or tokens to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
DEBUG=True                             # Set to False in production
APP_NAME="Technopie AI"
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000/api
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_jwt_and_cryptography
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours

# ------------------------------------------------------------------------------
# 2. CORS ALLOWED ORIGINS (Comma-separated or JSON list)
# ------------------------------------------------------------------------------
# In production on Render, set this to your frontend domain:
# CORS_ORIGINS=https://technopie-ai-frontend.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PostgreSQL + pgvector / Supabase)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL=sqlite+aiosqlite:///./technopie.db

# Production on Supabase (CRITICAL FOR RENDER FREE TIER):
# Render Free Web Services lack IPv6 support. You MUST use Supabase's IPv4
# Connection Pooler URL (Session Mode on port 6543, or Transaction Mode on 6543):
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Example:
# DATABASE_URL=postgresql+asyncpg://postgres.abcdefghijklmnop:SuperSecret123!@aws-0-us-west-1.pooler.supabase.com:6543/postgres?ssl=require

# Supabase Managed Database Reference (Optional metadata)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 4. AI PROVIDER API KEYS (Foundation LLM Abstraction Layer)
# ------------------------------------------------------------------------------
# Primary default provider: gemini | openai | anthropic | mock
DEFAULT_AI_PROVIDER=gemini
DEFAULT_FAST_MODEL=gemini-2.5-flash
DEFAULT_REASONING_MODEL=gemini-2.5-pro

# Set to false in production to enforce strict non-simulated real AI responses
ALLOW_MOCK_FALLBACK=false
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=3
AI_RETRY_BACKOFF_FACTOR=1.5

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API Key (Ready for Phase 3)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Ready for Phase 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 5. GOOGLE WORKSPACE OAUTH (Gmail & Google Calendar Integrations)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# In production on Render:
# GOOGLE_REDIRECT_URI=https://technopie-ai-backend.onrender.com/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Master AES-256-GCM 32-byte key for encrypting refresh tokens at rest in database
TOKEN_ENCRYPTION_KEY=change_this_to_a_secure_32_byte_aes_key_here!

# ------------------------------------------------------------------------------
# 6. FRONTEND ENVIRONMENT VARIABLES (Next.js)
# ------------------------------------------------------------------------------
# In production on Render/Vercel:
# NEXT_PUBLIC_API_URL=https://technopie-ai-backend.onrender.com/api
NEXT_PUBLIC_APP_NAME="Technopie AI"
NEXT_PUBLIC_API_URL=http://localhost:8000/api
